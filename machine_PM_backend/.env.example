# Machine Preventive Maintenance Backend Configuration
# Must match HERO backend SECRET_KEY so HERO JWT tokens verify cleanly
SECRET_KEY=django-insecure-hero-web-enterprise-secret-key-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,hero.pramaanu.co.in,*.pramaanu.co.in

# Primary Database – Machine PM (exclusive PM storage)
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/machine_pm_db

# Secondary Database – HERO Integration (read-only master & auth lookup)
HERO_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/hero_hdd_db

# Server port for independent execution
PM_BACKEND_PORT=8001

# JWT Settings (must match HERO backend)
JWT_ACCESS_TOKEN_LIFETIME=1440
JWT_REFRESH_TOKEN_LIFETIME=10080

# CORS / Frontend Integration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://hero.pramaanu.co.in
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://hero.pramaanu.co.in,https://*.pramaanu.co.in

# Photo Evidence Storage & Validation (stored in PostgreSQL BYTEA in machine_pm_db)
PM_MEDIA_ROOT=media
PM_MAX_PHOTO_SIZE_MB=10
PM_PHOTO_MAX_DIMENSION=1600
PM_PHOTO_JPEG_QUALITY=82
PM_ALLOWED_PHOTO_EXTENSIONS=jpg,jpeg,png,webp
PM_SOP_EXCEL_PATH=C:\Users\Lokendra\Downloads\Standard Operating Procedure- A600V2.xlsx
